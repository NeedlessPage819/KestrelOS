# Single source of truth for build inputs. Scripts read this file; change values here only.

OS_NAME="Kestrel OS"
IMAGE_NAME=kestrel
FEDORA_VERSION=44

# Upstream images. Their resolved digests are recorded in out/manifest.txt on every build.
BASE_IMAGE=ghcr.io/ublue-os/kinoite-main
AKMODS_NVIDIA_IMAGE=ghcr.io/ublue-os/akmods-nvidia-open
BIB_IMAGE=quay.io/centos-bootc/bootc-image-builder:latest
