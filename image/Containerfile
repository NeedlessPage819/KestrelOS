# Kestrel OS system image. Built by ../build.sh; all versions come from ../config.env.
ARG FEDORA_VERSION=44
ARG BASE_IMAGE=ghcr.io/ublue-os/kinoite-main
ARG AKMODS_NVIDIA_IMAGE=ghcr.io/ublue-os/akmods-nvidia-open

# Prebuilt, signed Nvidia kernel modules matching the base image kernel.
FROM ${AKMODS_NVIDIA_IMAGE}:main-${FEDORA_VERSION} AS akmods-nvidia

# macOS-style icons (DECISIONS.md D17). Built in their own stage: the clone is pinned to a
# tag and checked against the expected commit, and its installer never runs in the image.
FROM registry.fedoraproject.org/fedora:${FEDORA_VERSION} AS icons
ARG WHITESUR_ICONS_REPO
ARG WHITESUR_ICONS_TAG
ARG WHITESUR_ICONS_COMMIT
RUN dnf5 -y install git-core gtk-update-icon-cache findutils && \
    git clone --depth 1 --branch "${WHITESUR_ICONS_TAG}" "${WHITESUR_ICONS_REPO}" /src && \
    test "$(git -C /src rev-parse HEAD)" = "${WHITESUR_ICONS_COMMIT}" && \
    mkdir -p /out && cd /src && ./install.sh -d /out && \
    test -f /out/WhiteSur/index.theme

# Everything phase 2 adds to the image, assembled into one tree so the final image takes
# it in a single layer (each layer on the 15 GB image costs minutes). Artwork is rendered
# here from its sources, so the final image needs no artwork tooling.
FROM registry.fedoraproject.org/fedora:${FEDORA_VERSION} AS files
RUN dnf5 -y install librsvg2-tools python3
COPY artwork/ /src/
RUN share=/rootfs/usr/share && \
    mkdir -p $share/wallpapers/Kestrel/contents/images $share/wallpapers/Kestrel/contents/images_dark \
             $share/aurorae/themes $share/plasma/desktoptheme && \
    rsvg-convert -w 3840 -h 2160 -o $share/wallpapers/Kestrel/contents/images/3840x2160.png /src/wallpaper-light.svg && \
    rsvg-convert -w 3840 -h 2160 -o $share/wallpapers/Kestrel/contents/images_dark/3840x2160.png /src/wallpaper-dark.svg && \
    python3 /src/aurorae.py $share/aurorae/themes && \
    python3 /src/plasma_theme.py $share/plasma/desktoptheme
COPY --from=icons /out/ /rootfs/usr/share/icons/
COPY system_files/ /rootfs/
COPY build/build.sh build/lib.sh build/cleanup.sh /rootfs/tmp/build/
COPY build/configure/ /rootfs/tmp/build/configure/

FROM ${BASE_IMAGE}:${FEDORA_VERSION}
ARG OS_NAME="Kestrel OS"
ARG IMAGE_NAME=kestrel

# Phase 1, packages: only invalidated by package lists or install steps, so design and
# configuration changes below rebuild in minutes instead of reinstalling everything.
COPY packages/ /tmp/build/packages/
COPY build/build.sh build/lib.sh build/cleanup.sh /tmp/build/
COPY build/install/ /tmp/build/install/
RUN --mount=type=bind,from=akmods-nvidia,src=/rpms,dst=/tmp/akmods-nvidia \
    --mount=type=cache,dst=/var/cache/libdnf5 \
    /tmp/build/build.sh install

# Phase 2, configuration and artwork: one copy, one run.
COPY --from=files /rootfs/ /
RUN OS_NAME="${OS_NAME}" IMAGE_NAME="${IMAGE_NAME}" /tmp/build/build.sh configure && \
    bootc container lint
