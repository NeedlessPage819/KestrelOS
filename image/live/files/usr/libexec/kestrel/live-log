#!/usr/bin/env bash
# Writes the live session's logs to the stick itself (DECISIONS.md D30), so a machine that
# stays on a black screen can still be diagnosed: switch it off, plug the stick into another
# computer, and read the "KESTRELLOG" drive. Each boot gets its own folder (the newest 5 are
# kept). The logs are refreshed every 15 seconds for the first 10 minutes, so whatever stage
# the boot hangs at is in them. They contain only system logs and hardware details.
set -u

dev=/dev/disk/by-label/KESTRELLOG
for (( i = 0; i < 60; i++ )); do [[ -e $dev ]] && break; sleep 1; done
[[ -e $dev ]] || { echo "kestrel-live-log: no KESTRELLOG partition (ISO burnt to a DVD?), nothing to do"; exit 0; }

mnt=/run/kestrel-log
mkdir -p "$mnt"
mount -t vfat -o umask=022,flush "$dev" "$mnt" || { echo "kestrel-live-log: could not mount $dev"; exit 0; }
trap 'sync; umount "$mnt"' EXIT
trap 'exit 0' TERM INT   # shutdown: still run the EXIT trap, so the logs are complete

model=$(tr -c 'A-Za-z0-9.-' '_' </sys/class/dmi/id/product_name 2>/dev/null | cut -c1-32)
dir=$mnt/$(date +%Y%m%d-%H%M%S)-${model:-pc}
mkdir -p "$dir"
# Keep the newest three boots (debug logs are large; the partition has 64 MB).
ls -1d "$mnt"/*/ 2>/dev/null | sort | head -n -3 | xargs -r rm -rf

# Writes a command's output to the log folder; a hanging command is cut off after 20 s.
save() { local name=$1; shift; timeout 20 "$@" >"$dir/$name.tmp" 2>&1; mv -f "$dir/$name.tmp" "$dir/$name.txt"; }

save hardware bash -c 'cat /sys/class/dmi/id/{sys_vendor,product_name,bios_version} 2>/dev/null; uname -a;
    cat /proc/cmdline; echo; lspci -nnk; echo; lsusb; echo; free -m; echo; lsblk -o NAME,SIZE,TYPE,FSTYPE,LABEL; echo; cat /run/modprobe.d/*.conf 2>/dev/null'
for (( round = 0; round < 40; round++ )); do
    # Firmware (ACPI) event counters: shows an event flooding the system.
    save acpi-events bash -c 'cd /sys/firmware/acpi/interrupts && for f in *; do echo "$f $(cat $f)"; done | sort -k2 -nr | head -40'
    # Call stacks of everything stuck in an uninterruptible wait, at about 45 s, 2 min and 5 min:
    # shows which firmware routine or driver a hang is waiting on.
    if (( round == 3 || round == 8 || round == 20 )); then
        echo w >/proc/sysrq-trigger 2>/dev/null
        save "blocked-$round" bash -c 'for p in /proc/[0-9]*; do
            [[ $(awk "{print \$3}" $p/stat 2>/dev/null) == D ]] || continue
            echo "== ${p#/proc/} $(cat $p/comm 2>/dev/null)"; cat $p/stack 2>/dev/null; done | head -3000'
    fi
    save journal bash -c 'journalctl -b --no-pager -o short-monotonic | tail -c 16000000'
    save errors journalctl -b --no-pager -p warning -o short-monotonic
    save kernel bash -c 'dmesg -T | tail -c 8000000'
    save units bash -c 'systemctl --failed --no-pager; echo; systemctl list-jobs --no-pager; echo;
        systemctl status --no-pager display-manager.service plasmalogin.service livesys.service livesys-late.service 2>&1'
    save session bash -c 'loginctl list-sessions --no-pager; echo; ps -eo pid,etimes,stat,wchan:32,user,args --forest;
        echo; coredumpctl list --no-pager 2>&1 | tail -20'
    save graphics bash -c 'for c in /sys/class/drm/card*-*; do echo "$c: $(cat $c/status 2>/dev/null) $(head -1 $c/modes 2>/dev/null)"; done;
        echo; ls -l /dev/dri; echo; cat /proc/fb'
    sync
    sleep 15
done
echo "kestrel-live-log: done, logs in $dir"
