[Unit]
Description=Kestrel OS live session: more room for changes (Steam, Flatpak apps, Wine)
# The live system keeps every change in /run, which systemd sizes at 20% of RAM (about 3 GB on
# 16 GB). Steam's runtime, the Flathub catalogue and Wine set-ups need more (DECISIONS.md D31).
# tmpfs only uses memory for what is actually written; the rest stays free.
DefaultDependencies=no
After=systemd-remount-fs.service
Before=sysinit.target

[Service]
Type=oneshot
ExecStart=/usr/bin/mount -o remount,size=60%% /run
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
