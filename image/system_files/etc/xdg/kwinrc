# Animations (DECISIONS.md D18): windows zoom in and out like on macOS, minimizing
# uses the genie-like Magic Lamp into the dock. Fade and squash would do the same job.
[Plugins]
blurEnabled=true
scaleEnabled=true
fadeEnabled=false
magiclampEnabled=true
squashEnabled=false
maximizeEnabled=true
# Game controllers work on the desktop (DECISIONS.md D35): a stick moves the pointer, A is
# Enter, B Esc, the D-pad the arrow keys, Start opens the Launchpad. Paused during games by
# /usr/libexec/kestrel/gamepad-guard. Off switch: System Settings > Game Controller.
gamecontrollerEnabled=true

[org.kde.kdecoration2]
library=org.kestrel.decoration
ButtonsOnLeft=XIA
ButtonsOnRight=

# A lone Super/Windows key press does nothing (as on macOS). Otherwise an accidental press
# in a game opens the launcher and pulls focus out of it. Search stays on Meta+Space.
[ModifierOnlyShortcuts]
Meta=
