# Kestrel OS window rules (DECISIONS.md D27). Users can change or add rules in System Settings >
# Window Management > Window Rules.
[General]
count=1
rules=kestrel-terminal

# The terminal's window frame uses dark colours, so its title bar matches the dark terminal.
[kestrel-terminal]
Description=Kestrel: dark title bar for the terminal
wmclass=org.kde.konsole
wmclasscomplete=false
wmclassmatch=1
decocolor=BreezeDark
decocolorrule=2
