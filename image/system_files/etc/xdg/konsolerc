# Kestrel OS terminal (DECISIONS.md D27): the Kestrel profile; tabs only when there is more than one.
# The toolbars are hidden in /usr/share/kxmlgui5/konsole/*.rc (everything is in the top bar menu).
[Desktop Entry]
DefaultProfile=Kestrel.profile

# Kept from Fedora's konsolerc, which this file replaces.
[MainWindow]
MenuBar=Disabled

[FileLocation]
scrollbackUseCacheLocation=true
scrollbackUseSystemLocation=false

[TabBar]
TabBarVisibility=ShowTabBarWhenNeeded
NewTabBehavior=PutNewTabAfterCurrentTab
CloseTabOnMiddleMouseButton=true





[KonsoleWindow]
RememberWindowSize=true
# The window title is the tab title (the folder name), not what the shell sets.
ShowWindowTitleOnTitleBar=false
