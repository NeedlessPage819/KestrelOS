# Kestrel icons: WhiteSur plus a few overrides for the dock (DECISIONS.md D17).
# Panel applets ask for "-symbolic" icons, meant for the slim top bar; in the large dock the
# trash should look like the other app icons. The overrides are links made at build time.
[Icon Theme]
Name=Kestrel
Comment=WhiteSur with dock-sized trash icons
Inherits=WhiteSur,breeze,hicolor
Directories=places/scalable

[places/scalable]
Size=64
Context=Places
MinSize=8
MaxSize=512
Type=Scalable
