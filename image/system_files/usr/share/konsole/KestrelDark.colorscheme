[General]
Description=Kestrel Dark
# Kestrel OS terminal colours for dark mode (DECISIONS.md D27): calm dark grey with soft text and
# the Kestrel accent (#8d9af6). The background is the dark title bar colour of the Kestrel window
# frame (#2c2b30), so title bar and terminal are one surface. In light mode
# KestrelLight.colorscheme is used instead (Konsole switches by itself, see /etc/xdg/konsolerc).
Opacity=1
Blur=false
Wallpaper=
FillStyle=Tile
Anchor=0.5,0.5
WallpaperOpacity=1

[Background]
Color=44,43,48

[BackgroundIntense]
Color=54,53,60

[BackgroundFaint]
Color=44,43,48

[Foreground]
Color=226,226,234

[ForegroundIntense]
Color=245,245,250

[ForegroundFaint]
Color=160,160,176

