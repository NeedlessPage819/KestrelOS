[General]
Description=Kestrel Light
# Kestrel OS terminal colours for light mode (DECISIONS.md D27): a light "paper" terminal. The
# background is the light title bar colour of the Kestrel window frame (#f3f3f5), so title bar
# and terminal are one surface. Text is dark ink; the colours read well on the light background
# (contrast 4.5:1 or better). "White" (Color7) is a grey ink, so white text can still be read.
# In dark mode KestrelDark.colorscheme is used instead (Konsole switches by itself, see /etc/xdg/konsolerc).
Opacity=1
Blur=false
Wallpaper=
FillStyle=Tile
Anchor=0.5,0.5
WallpaperOpacity=1

[Background]
Color=243,243,245

[BackgroundIntense]
Color=232,232,238

[BackgroundFaint]
Color=243,243,245

[Foreground]
Color=43,42,51

[ForegroundIntense]
Color=22,22,30

[ForegroundFaint]
Color=120,120,134

